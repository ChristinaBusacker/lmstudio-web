# --- Environment Variables ---
NODE_ENV=production
PORT=3000 #use 3001 in develop mode.
HOST=0.0.0.0
DB_PATH=../data/app.sqlite

# --- External Services  ---
LMSTUDIO_BASE_URL=http://127.0.0.1:1234
LMSTUDIO_DEFAULT_MODEL=openai/gpt-oss-20b
LMSTUDIO_WEB_ENABLE_OCR=true

SEARXNG_BASE_URL=http://localhost:8081

# --- Workflow safety budgets (bytes) ---
WORKFLOW_MAX_PROMPT_BYTES=200000
WORKFLOW_MAX_UPSTREAM_BYTES=80000
WORKFLOW_MAX_LOOP_CONDITION_BYTES=120000
WORKFLOW_MAX_LOOP_TOTAL_PRODUCED_BYTES=250000


